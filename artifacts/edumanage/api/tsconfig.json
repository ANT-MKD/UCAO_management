// Fonctions Vercel (api/) : Vercel compile chacune avec le tsconfig le plus proche. Celui de
// l'application (allowImportingTsExtensions, réservé à noEmit) l'empêcherait de produire le code
// et la mise en ligne échouerait (« Emit skipped »).
{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
